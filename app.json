{
  "expo": {
    "name": "일당백 (Day100)",
    "slug": "day100",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "react-native-webview"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dohunkim72.day100"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dohunkim72.day100"
    },
    "web": {
      "favicon": "./public/favicon.ico",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "6acd899e-2671-4535-be26-22497a29efab"
      }
    }
  }
}
